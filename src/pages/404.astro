---
import '@fontsource-variable/geologica/full.css';
import '../styles/global.css';
import { locales } from '../i18n';
import Logo from '../components/Logo.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Neovate</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="blue">
    <main class="wrap notfound">
      <a class="logo" href="/" aria-label="Neovate"><Logo /></a>
      <p class="notfound-code" aria-hidden="true">404</p>
      {locales.map((l) => (
        <section lang={l.code} class="notfound-row">
          <h1>{l.dict.notFound.title}</h1>
          <p>{l.dict.notFound.text} <a href={l.code === 'en' ? '/' : `/${l.code}/`}>{l.dict.notFound.home}</a></p>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  .notfound {
    min-height: 100vh;
    padding-block: 1.4rem 4rem;
  }
  .notfound-code {
    margin-block: 2rem 2.5rem;
    font-size: clamp(6rem, 28vw, 20rem);
    font-weight: 820;
    line-height: 0.8;
    letter-spacing: -0.06em;
    font-variation-settings: 'SHRP' 100;
  }
  .notfound-row {
    padding-block: 1rem;
    border-top: 1px solid rgb(238 241 245 / 0.3);
  }
  .notfound-row h1 {
    font-size: 1.5rem;
    font-weight: 560;
  }
  .notfound-row p {
    color: rgb(238 241 245 / 0.86);
  }
</style>
